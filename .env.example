# Copy to .env for local runs. On GitHub, add these as repository secrets instead.

# Required: from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxyz

# Required in production: Supabase > Project Settings > Database > Connection string (URI, "Session pooler")
# Leave unset locally to use a SQLite file.
# DATABASE_URL=postgresql://postgres.xxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional: your own Telegram chat id, gets a short report after each run (send /start to @userinfobot to find it)
# ADMIN_CHAT_ID=123456789

# Optional: free Adzuna API key from developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Optional tuning
# JOBSPY_ENABLED=1
# JOBSPY_SITES=indeed,linkedin,naukri,glassdoor
# JOBSPY_RESULTS=30
# HOURS_OLD=48
# MAX_SEARCH_QUERIES=25
# MAX_JOBS_PER_USER=10

# Only for the optional instant webhook (Step 7 in README)
# TELEGRAM_WEBHOOK_SECRET=any-long-random-string
